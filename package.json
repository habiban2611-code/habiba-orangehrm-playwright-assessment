{
  "name": "habiba-orangehrm-playwright-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright functional and edge-case tests for OrangeHRM",
  "author": "Habiba",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:part1": "playwright test tests/part1.spec.ts",
    "test:part2": "playwright test tests/part2.spec.ts",
    "test:report": "playwright show-report test-results/report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
